{
  "version": 2,
  "builds": [
    { "src": "MVFrontend/package.json", "use": "@vercel/static-build" },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },

    { "src": "/assets/(.*)", "dest": "MVFrontend/dist/assets/$1" },
    { "src": "/(.*\\..*)", "dest": "MVFrontend/dist/$1" },

    { "src": "/.*", "dest": "MVFrontend/dist/index.html" }
  ]
}
