{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "MVFrontend/package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    {
      "src": "/(.*)",
      "dest": "MVFrontend/index.html",
      "continue": true
    }
  ]
}
